# ── Environment ──────────────────────────────────────────────────────────
# Controls which YAML overlay (local.yaml / staging.yaml / production.yaml)
# is deep-merged on top of base.yaml.  Also gates debug output and
# safety checks (e.g., destructive operations are blocked in production).
ENVIRONMENT=local

# ── Secrets ──────────────────────────────────────────────────────────────
# OpenAI key used by the RAG chatbot service.
OPENAI_API_KEY=sk-your-key-here

# ── Infrastructure ───────────────────────────────────────────────────────
# MLflow experiment tracking server URL.
MLFLOW_TRACKING_URI=http://localhost:5000

# Docker Compose project name (avoids collisions when running multiple
# Compose stacks on the same host).
COMPOSE_PROJECT_NAME=cip

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string.  Used by services that need persistent
# storage (churn pipeline, CLV pipeline).  Never commit real credentials
# to version control — copy this file to .env and fill in real values.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
